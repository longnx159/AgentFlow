{
  "name": "agent-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "manager": "tsx src/manager/main.ts",
    "worker": "tsx src/worker/main.ts",
    "test": "tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start:manager": "node dist/src/manager/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "format": "prettier --write src public test scripts examples README.md docs package.json tsconfig.json",
    "test:e2e": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cron-parser": "5.10.4",
    "express": "^4.21.2",
    "node-red": "5.0.9",
    "playwright-core": "^1.56.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
